{
  "name": "asterpath-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro ../public/video/asterpath-intro.mp4 --codec=h264 --crf=20",
    "render:vertical": "remotion render src/index.ts IntroVertical out/asterpath-intro-vertical.mp4 --codec=h264 --crf=20",
    "poster": "remotion still src/index.ts Intro ../public/video/asterpath-intro-poster.jpg --frame=200 --image-format=jpeg --jpeg-quality=82"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "d3-geo": "3.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "typescript": "6.0.3"
  }
}
