# AsterPath environment configuration
# Copy to .env.local for local development. Never commit real values.
# Every value below is a placeholder. The app runs locally with none of the
# optional integrations configured and shows a clear "not connected" state.

# ── Public site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Digits only, international format, no "+". Default is the main support line.
NEXT_PUBLIC_WHATSAPP_NUMBER=393311104575
# Reserved development placeholder — replace before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@asterpath.example

# Free consultation calendar: your Cal.com booking link (https://cal.com/... only).
# In Cal.com connect Google Calendar and set the event's location to Google Meet.
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-name/consultation
# Cal.com → Settings → Developer → Webhooks: URL https://<your-domain>/api/webhooks/cal,
# events Booking created / rescheduled / cancelled, and paste the same secret here.
# CAL_WEBHOOK_SECRET=server-only-at-least-16-characters

# ── Enquiry storage ───────────────────────────────────────────────────────
# "local"  → development only: writes synthetic enquiries to .data/leads.ndjson
# "none"   → enquiries are rejected with a WhatsApp fallback (default in production until Supabase is configured)
# "supabase" → saves to the leads table (default in production once Supabase is configured)
LEAD_STORE=local

# ── Rate limiting: where the real client address comes from ─────────────
# Set ONE of these to match your host, or every visitor shares one small allowance.
# CLIENT_IP_HEADER  → a header your platform overwrites with the caller's address
#                     (for example x-real-ip behind nginx with proxy_set_header X-Real-IP $remote_addr).
# TRUSTED_PROXY_HOPS → number of trusted proxies that each append to X-Forwarded-For.
# CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXY_HOPS=1

# ── Supabase (Phase 2) ────────────────────────────────────────────────────
# From your Supabase project: Settings → API. Leave unset and accounts stay closed
# (sign-in shows "not open yet", /portal and /admin return 404 in production).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only: bypasses Row Level Security. Used only to save enquiries.
# Never prefix with NEXT_PUBLIC_, never paste it into chat or commit it.
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose-to-browser
# With both set, production saves enquiries to Supabase. To force a store: LEAD_STORE=supabase

# ── Razorpay (Phase 6 — test mode only, not used yet) ─────────────────────
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=server-only-replace-me
# RAZORPAY_WEBHOOK_SECRET=server-only-replace-me

# ── Email: new-enquiry alerts and student confirmations (Resend) ─────────
# RESEND_API_KEY=server-only-replace-me
# EMAIL_FROM="AsterPath <hello@your-domain>"
# Your inbox for new-enquiry alerts (each has a one-tap WhatsApp reply).
# LEAD_NOTIFY_EMAIL=you@example.com

# ── Demo workspace ───────────────────────────────────────────────────────
# Synthetic admin/portal data is shown in development only. Set to "enabled" to
# show it to signed-in staff on a production preview. Never on the live site.
# DEMO_WORKSPACE=enabled

# ── Local AI (Phase 7 — optional) ─────────────────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ── Vercel cron ──────────────────────────────────────────────────────────
# Vercel sends this as a bearer token to /api/cron/prune-analytics (daily,
# deletes website analytics older than 13 months). Any long random string.
# CRON_SECRET=server-only-long-random-string
